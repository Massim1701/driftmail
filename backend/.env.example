# driftmail-backend — Beispiel-Konfiguration. Kopieren nach .env und anpassen.
# Ohne jede dieser Variablen läuft der Server trotzdem: dann wird pro Konto
# der Fixture-Mail-Adapter (src/mail/fixtureAdapter.ts) statt echtem
# Gmail/IMAP-Zugriff verwendet. Siehe README.md.

PORT=3000

# --- Gmail (nur nötig für echten Gmail-Sync) ---
# OAuth2-Client aus der Google Cloud Console + ein bereits autorisiertes
# Refresh-Token (Consent-Flow ist nicht Teil dieses Skeletons).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- IMAP (nur nötig für echten IMAP-Sync) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
